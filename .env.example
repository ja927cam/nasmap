# ---------------------------------------------------------------------------
# NasMap configuration. Copy to .env and change the secrets before exposing
# this instance to a network you do not fully trust.
# ---------------------------------------------------------------------------
# Public address Caddy listens on. Use http://localhost for LAN/development,
# or a domain such as maps.example.com for automatic HTTPS.
SITE_ADDRESS=http://localhost
HTTP_PORT=80
HTTPS_PORT=443

# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string
# Optional dedicated key for encrypting OSM OAuth tokens. If empty, a key is
# derived from SECRET_KEY. Changing it logs everyone out of OSM publishing.
OSM_TOKEN_ENCRYPTION_KEY=

# PostgreSQL credentials (used by db + api + worker).
POSTGRES_DB=nasmap
POSTGRES_USER=nasmap
POSTGRES_PASSWORD=change-me-postgres-password
# Keep this URL in sync with the three values above. URL-encode special
# characters in the password (or use an alphanumeric password).
DATABASE_URL=postgresql+asyncpg://nasmap:change-me-postgres-password@db:5432/nasmap

# Redis for the background worker queue and rate limiting.
REDIS_URL=redis://redis:6379/0

# Browser-facing URLs. SITE_URL is where the app is reachable.
SITE_URL=http://localhost
FRONTEND_URL=http://localhost
# Comma separated list of additional allowed CORS origins.
CORS_ORIGINS=

# Storage (Docker volumes by default).
UPLOAD_DIR=/data/uploads
TESSERA_CACHE_DIR=/data/tessera
TILES_DIR=/data/tiles

# Uploads and remote fetches.
MAX_UPLOAD_MB=512
# Per-photo limit for EXIF geotag imports (JPEG, TIFF, PNG, WebP, RAF).
MAX_PHOTO_MB=100

# Server/NAS-side bulk ingestion. Mount a host folder read-only at /ingest
# (or change INGEST_PATH) and point INGEST_ROOTS at the container path(s).
# Examples:
#   Synology: INGEST_PATH=/volume1/photo
#   QNAP:     INGEST_PATH=/share/Photos
#   Unraid:   INGEST_PATH=/mnt/user/Photos
INGEST_PATH=./data/ingest
# Container UID/GID. Match the owner of your NAS share if it is not readable
# by uid/gid 1000 (Synology/QNAP/Unraid often use different IDs).
PUID=1000
PGID=1000
INGEST_ENABLED=true
INGEST_ROOTS=/ingest
INGEST_MAX_SCAN_FILES=1000
INGEST_MAX_FILES_PER_JOB=5000
MAX_URL_IMPORT_MB=1024
URL_FETCH_TIMEOUT_SECONDS=90
ALLOWED_URL_SCHEMES=http,https
# Opt in only on a trusted LAN: enables remote imports and WMS proxies from
# private/loopback addresses (otherwise blocked as SSRF).
ALLOW_PRIVATE_URL_IMPORTS=false

# Auth. ACCESS_TOKEN_TTL_MINUTES short-lived; refresh token is an httpOnly
# cookie. Set COOKIE_SECURE=true whenever SITE_URL is HTTPS.
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_DOMAIN=
FIRST_USER_IS_ADMIN=true
REGISTRATION_ENABLED=true

# Rate limits (requests per window per IP).
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT=30
UPLOAD_RATE_WINDOW_SECONDS=3600

# Basemap: remote_osm (default, zero downloads) or local (TileServer GL).
BASEMAP_MODE=remote_osm
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
OSM_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# Serve remote OSM tiles through NasMap with an on-demand disk cache. This
# keeps upstream requests polite and makes repeat views fast.
OSM_TILE_PROXY=true
OSM_TILE_CACHE_TTL_DAYS=7
# Cache generic raster overlays (XYZ/TileJSON) fetched by the API.
OVERLAY_TILE_CACHE_TTL_HOURS=24
# Browser-facing TileServer GL base. Caddy exposes it under /tiles.
TILESERVER_PUBLIC_URL=/tiles
TILESERVER_INTERNAL_URL=http://tileserver:8080

# OSM OAuth 2.0. Register an application at
# https://www.openstreetmap.org/oauth2/applications
# Callback URL: https://your-domain/api/v1/osm/callback
OSM_OAUTH_ENABLED=false
OSM_CLIENT_ID=
OSM_CLIENT_SECRET=
OSM_REDIRECT_URI=http://localhost/api/v1/osm/callback
# Use https://master.apis.dev.openstreetmap.org for the dev server.
OSM_API_BASE_URL=https://api.openstreetmap.org
OSM_AUTH_URL=https://www.openstreetmap.org/oauth2/authorize
OSM_TOKEN_URL=https://www.openstreetmap.org/oauth2/token
OSM_SCOPES=read_prefs write_api
# Allow OSM sign-in to auto-create a viewer account for first-time OSM users.
# Linked accounts can always sign in with OSM even when this is false.
OSM_SIGNIN_AUTO_CREATE=false

# Editable OSM imports via Overpass. This creates local editable copies in the
# app schema; edits are NOT written back to OpenStreetMap automatically.
OVERPASS_ENABLED=true
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=90
OVERPASS_MAX_AREA_DEG2=0.05
OVERPASS_MAX_MB=64

# Tessera / GeoTessera.
TESSERA_ENABLED=true
TESSERA_VERSION=v1.1
# v1.1 NPY GeoTIFF export uses the "cambridge" variant.
TESSERA_VARIANT=cambridge
# Empty uses the published default registry. Set a mirror for offline installs.
TESSERA_REGISTRY_URL=
TESSERA_MAX_TILES=64

# Place-name search in the Tessera wizard. Uses a public Nominatim endpoint by
# default; point this at your own instance for heavy use.
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODING_ENABLED=true

# Operational.
ENV=production
LOG_LEVEL=INFO
JSON_LOGS=true
DEBUG=false
# Set to false only for throwaway local experiments.
RATE_LIMITING_ENABLED=true
